# Maintainer: RedMoth <put your e-mail here before uploading>
pkgname=pngfit
pkgver=1.1.0
pkgrel=1
pkgdesc='Make a truecolor PNG or APNG exactly N bytes with the least visible loss'
arch=('x86_64' 'aarch64')
url='https://github.com/LicaRedMoth/pngfit'
license=('MIT')
depends=('glibc' 'libdeflate' 'zlib')
checkdepends=('python' 'python-numpy' 'python-pillow')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('21b8144f3e3f718c524c089b80045fbbc188f364d7afeb65f388092beb70ea78')

build() {
  cd "$pkgname-$pkgver"
  make
}

check() {
  cd "$pkgname-$pkgver"
  make check
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
