# Maintainer: RedMoth <put your e-mail here before uploading>
pkgname=pngfit
pkgver=1.1.1
pkgrel=1
pkgdesc='Make a truecolor PNG or APNG exactly N bytes with the least visible loss'
arch=('x86_64' 'aarch64')
url='https://github.com/LicaRedMoth/pngfit'
license=('MIT')
depends=('glibc' 'libdeflate' 'zlib')
checkdepends=('python' 'python-numpy' 'python-pillow')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('54ca51475c3b9450688b7943051a0c0d1b9a7c3e838933d45b04ea3e53dc7924')

build() {
  cd "$pkgname-$pkgver"
  make
}

check() {
  cd "$pkgname-$pkgver"
  make check
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
